PORT=5000
CLIENT_URL=http://localhost:3000

# Auth removed — site is public

# Razorpay — get keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# SMTP — use Gmail App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM=PC Deals India <your_email@gmail.com>

# WhatsApp — use Gupshup API (https://www.gupshup.io)
WHATSAPP_API_URL=https://api.gupshup.io/sm/api/v1
WHATSAPP_API_KEY=your_gupshup_api_key
WHATSAPP_PHONE_NUMBER=919xxxxxxxxx

# Tax rate (decimal, e.g. 0.18 for 18% GST)
TAX_RATE=0.18
GSTIN=XXXXXXXXXXXXX
SHOP_NAME=Shree Hira Computer & Communication
SHOP_ADDRESS=Your Shop Address, City, State - PIN
